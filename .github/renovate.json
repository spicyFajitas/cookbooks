{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "America/Los_Angeles",
  "schedule": [
    "* 1-5 * * *"
  ],
  "assignees": [
    "spicyFajitas"
  ],
  "reviewers": [
    "spicyFajitas"
  ],
  "pre-commit": {
    "enabled": true
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^kubernetes/(apps|platform)/.+\\.ya?ml$/"
    ]
  },
  "argocd": {
    "managerFilePatterns": [
      "/^kubernetes/argocd-apps/.+\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "k3s version in ansible role defaults",
      "managerFilePatterns": [
        "/^ansible/roles/k3s_server/defaults/main\\.ya?ml$/"
      ],
      "matchStrings": [
        "k3s_version:\\s*[\"']?(?<currentValue>v[^\\s\"']+)"
      ],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k3s(?<build>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    }
  ]
}
